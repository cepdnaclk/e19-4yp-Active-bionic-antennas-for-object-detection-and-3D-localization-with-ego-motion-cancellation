<launch>

  <!-- Antenna Controller -->
  <node
    name="contact_search_controller"
    pkg="motor_control"
    type="contact_search_controller.py"
    output="screen"
    launch-prefix="python3"
  >
    <param name="pan_channel" value="0"/>
    <param name="tilt_channel" value="1"/>
  </node>

  <!-- Run the IMU publisher node -->
  <node name="imu_antenna_publisher" pkg="imu_sensing" type="antenna_acc_pub.py" output="screen" />
  <node name="imu_bottom_publisher" pkg="imu_sensing" type="bottom_acc_pub.py" output="screen" />

  <!-- Launch the command sender node (choose sequence 1-4) -->
  <node 
    name="command_sender"
    pkg="main_control"
    type="command_sender.py"
    output="screen"
    launch-prefix="python2"
  >
    <param name="sequence" value="3"/>
    <param name="session_id" value="session_001"/>
  </node>

  <!-- Launch the base communication node -->
  <node
    name="base_communication"
    pkg="robot_navigation"
    type="base_communication.py"
    output="screen"
    launch-prefix="python2"
  >
    <param name="port" value="/dev/ttyUSB0"/>
    <param name="baud" value="115200"/>
  </node>

</launch>
